{
  "cniVersion": "1.0.0",
  "name": "narc",
  "plugins": [
    { "type": "loopback" },
    {
      "type": "bridge",
      "bridge": "narc",
      "isGateway": true,
      "ipMasq": true,
      "ipam": {
        "type": "host-local",
        "ranges": [[{ "subnet": "172.31.250.0/24" }]],
        "routes": [{ "dst": "0.0.0.0/0" }]
      }
    }
  ]
}
